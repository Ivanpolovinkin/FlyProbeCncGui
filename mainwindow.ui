            <string notr="true">QPushButton {
  background-color: #f0f0f0; /* Светло-серый фон */
  border: 1px solid #999999; /* ИСПРАВЛЕНО: Более тёмная, чёткая рамка */
  border-radius: 4px;        /* Скруглённые углы */
  color: #333333;            /* Тёмно-серый текст */
  font-weight: bold;
}
QPushButton:hover {
  background-color: #e0e0e0; /* При наведении фон чуть темнее */
  border-color: #777777;     /* Рамка становится ещё темнее и активнее */
}
QPushButton:pressed {
  background-color: #d0d0d0; /* При клике фон самый тёмный */
  border-color: #555555;     /* Рамка при клике */
}
QPushButton:disabled {
  background-color: #f9f9f9; /* Стиль для заблокированной кнопки */
  color: #aaaaaa;
  border-color: #cccccc;     /* У заблокированной кнопки рамку делаем блёклой */
}</string>
