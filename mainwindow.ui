         <item>
          <widget class="QComboBox" name="comboPorts">
           <property name="styleSheet">
            <string notr="true">/* ==========================================================================
   ФИНАЛЬНЫЙ СТИЛЬ ДЛЯ КОМБОБОКСА ПОРТОВ (С ТЕКСТОМ ПО ЦЕНТРУ)
   ========================================================================== */

/* Базовое описание комбобокса */
QComboBox#comboPorts {
    border-radius: 4px;
    padding: 3px 5px;
    min-height: 20px;
    font-weight: bold;
    background-color: #ffffff;
    /* Центрируем текст внутри комбобокса */
    text-align: center; 
}

/* Избавляемся от квадрата справа (делаем его невидимым) */
QComboBox#comboPorts::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 0px;                  /* Схлопываем ширину квадрата до 0 */
    border-left-width: 0px;      /* Убираем вертикальную разделительную линию */
    border-style: none;          /* Полностью скрываем рамку */
    background-color: transparent; /* Делаем фон прозрачным */
}

/* Центрируем текст элементов внутри выпадающего списка при нажатии */
QComboBox#comboPorts QAbstractItemView {
    text-align: center;
}

/* --- СТАРТ / ДИСКОННЕКТ (КРАСНЫЙ КОНТУР И ТЕКСТ) --- */
QComboBox#comboPorts[connectionStatus=&quot;disconnected&quot;] {
    border: 2px solid #ff4d4d;
    color: #b30000;
}

/* --- УСПЕШНОЕ ПОДКЛЮЧЕНИЕ (ЗЕЛЕНЫЙ КОНТУР И ТЕКСТ) --- */
QComboBox#comboPorts[connectionStatus=&quot;connected&quot;] {
    border: 2px solid #2ecc71;
    color: #27ae60;
}</string>
           </property>
